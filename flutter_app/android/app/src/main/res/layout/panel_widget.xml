<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="透明玻璃背景"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical">
<ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_launcher" android:contentDescription="青龙掌控"/>
<TextView android:id="@+id/widget_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="青龙掌控" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_refresh" android:layout_width="34dp" android:layout_height="26dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:contentDescription="刷新小组件"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
<TextView android:id="@+id/widget_total" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="—" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="1"/>
<TextView android:id="@+id/widget_total_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="任务总数" android:textSize="10sp"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
<TextView android:id="@+id/widget_running" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="—" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="1"/>
<TextView android:id="@+id/widget_running_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="运行中" android:textSize="10sp"/>
</LinearLayout>
</LinearLayout>
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical" android:text="打开 App 同步面板" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical">
<TextView android:id="@+id/widget_tasks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_button" android:gravity="center" android:text="任务" android:textSize="12sp"/>
<TextView android:id="@+id/widget_envs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="7dp" android:background="@drawable/widget_button" android:gravity="center" android:text="变量" android:textSize="12sp"/>
<TextView android:id="@+id/widget_scripts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="7dp" android:background="@drawable/widget_button" android:gravity="center" android:text="脚本" android:textSize="12sp"/>
</LinearLayout></LinearLayout></FrameLayout>